#!/bin/bash
# System Update Notifier
# Supports Fedora (dnf5 / dnf), Arch Linux (checkupdates), and Debian/Ubuntu (apt)

UPDATES=0

if command -v dnf5 &> /dev/null; then
    UPDATES=$(dnf5 check-upgrade -q 2>/dev/null | grep -E '^[a-zA-Z0-9]' | wc -l)
elif command -v dnf &> /dev/null; then
    UPDATES=$(dnf check-update -q 2>/dev/null | grep -E '^[a-zA-Z0-9]' | wc -l)
elif command -v checkupdates &> /dev/null; then
    UPDATES=$(checkupdates 2>/dev/null | wc -l)
elif command -v apt-get &> /dev/null; then
    UPDATES=$(apt-get -s upgrade 2>/dev/null | grep -P '^\d+ upgraded' | awk '{print $1}')
fi

if [ -n "$UPDATES" ] && [ "$UPDATES" -gt 0 ]; then
    if [ "$UPDATES" -eq 1 ]; then
        notify-send -u normal "Atualização Disponível" "Há 1 pacote disponível para atualização no Fedora."
    else
        notify-send -u normal "Atualizações Disponíveis" "Há $UPDATES pacotes disponíveis para atualização no Fedora."
    fi
fi