#!/bin/bash
# ==============================================================================
# git-aicommit - Gerador automático de Conventional Commits com IA
# ==============================================================================

set -e

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "❌ Erro: O diretório atual não é um repositório Git."
    exit 1
fi

# Verificar se há alterações preparadas (staged)
if git diff --cached --quiet; then
    if git diff --quiet; then
        echo "ℹ️  Nenhuma alteração detectada no repositório."
        exit 0
    else
        echo "⚠️  Nenhuma alteração em 'staged'. Deseja adicionar todas as alterações (git add -A)? [s/N]"
        read -r reply
        if [[ "$reply" =~ ^[sSyY]$ ]]; then
            git add -A
        else
            echo "Operação cancelada. Adicione as alterações com 'git add' antes de gerar o commit."
            exit 0
        fi
    fi
fi

DIFF_CONTENT=$(git diff --cached | head -c 8000)

if [ -z "$DIFF_CONTENT" ]; then
    echo "❌ Não foi possível extrair o diff das alterações."
    exit 1
fi

export PATH="$HOME/.gemini/bin:$HOME/.local/bin:$PATH"

generate_message() {
    PROMPT="Você é um especialista em Git e Conventional Commits.
Analise as alterações a seguir e gere APENAS a primeira linha da mensagem de commit no formato convencional:
<tipo>(<escopo>): <descrição em português no imperativo>

Exemplos:
- feat(hyprland): adiciona atalho para scratchpad de ia
- fix(waybar): corrige atualização de tema dinâmico
- refactor(bash): modulariza variáveis de ambiente

Tipos permitidos: feat, fix, docs, style, refactor, perf, test, chore, build, ci.
Retorne ESTRITAMENTE a linha da mensagem de commit, sem aspas, crases ou explicações extras.

Diff:
$DIFF_CONTENT"

    if command -v agy &>/dev/null; then
        agy -p "$PROMPT" 2>/dev/null | tr -d '`' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | head -n 1
    elif [ -n "$GEMINI_API_KEY" ] && command -v python3 &>/dev/null; then
        python3 - << EOF 2>/dev/null
import os
from google import genai
try:
    client = genai.Client(api_key=os.environ.get("GEMINI_API_KEY"))
    res = client.models.generate_content(
        model="gemini-2.5-flash",
        contents="""$PROMPT"""
    )
    print(res.text.strip().replace('`', '').splitlines()[0])
except Exception:
    pass
EOF
    fi
}

echo "🤖 Analisando diff e gerando mensagem de commit com IA..."
COMMIT_MSG=$(generate_message)

if [ -z "$COMMIT_MSG" ]; then
    COMMIT_MSG="chore: atualizações no projeto"
fi

while true; do
    echo ""
    echo "=========================================================="
    echo " Mensagem sugerida:"
    echo "   $COMMIT_MSG"
    echo "=========================================================="
    echo "[Enter] Confirmar e commitar"
    echo "[e]     Editar mensagem"
    echo "[r]     Regenerar sugestão"
    echo "[c]     Cancelar"
    read -p "Opção: " choice

    case "$choice" in
        "")
            git commit -m "$COMMIT_MSG"
            echo "✅ Commit realizado com sucesso!"
            break
            ;;
        [eE]*)
            read -p "Digite a nova mensagem de commit: " NEW_MSG
            if [ -n "$NEW_MSG" ]; then
                git commit -m "$NEW_MSG"
                echo "✅ Commit realizado com sucesso!"
            else
                echo "Operação cancelada."
            fi
            break
            ;;
        [rR]*)
            echo "🔄 Gerando nova sugestão..."
            COMMIT_MSG=$(generate_message)
            ;;
        [cC]*)
            echo "❌ Operação cancelada."
            break
            ;;
        *)
            echo "Opção inválida."
            ;;
    esac
done
