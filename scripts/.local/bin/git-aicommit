#!/bin/bash
# git-aicommit - Gerador automatico de Conventional Commits

set -e

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "[erro] O diretorio atual nao e um repositorio Git."
    exit 1
fi

# Verificar se ha alteracoes preparadas (staged)
if git diff --cached --quiet; then
    if git diff --quiet; then
        echo "Nenhuma alteracao detectada no repositorio."
        exit 0
    else
        echo "Nenhuma alteracao em staged. Deseja adicionar todas as alteracoes (git add -A)? [s/N]"
        read -r reply
        if [[ "$reply" =~ ^[sSyY]$ ]]; then
            git add -A
        else
            echo "Operacao cancelada. Adicione as alteracoes com 'git add' antes de gerar o commit."
            exit 0
        fi
    fi
fi

DIFF_CONTENT=$(git diff --cached | head -c 8000)

if [ -z "$DIFF_CONTENT" ]; then
    echo "[erro] Nao foi possivel extrair o diff das alteracoes."
    exit 1
fi

export PATH="$HOME/.gemini/bin:$HOME/.local/bin:$PATH"

generate_message() {
    PROMPT="Voce e um especialista em Git e Conventional Commits.
Analise as alteracoes a seguir e gere APENAS a primeira linha da mensagem de commit no formato convencional:
<tipo>(<escopo>): <descricao em portugues no imperativo>

Exemplos:
- feat(hyprland): adiciona atalho para scratchpad de ia
- fix(waybar): corrige atualizacao de tema dinamico
- refactor(bash): modulariza variaveis de ambiente

Tipos permitidos: feat, fix, docs, style, refactor, perf, test, chore, build, ci.
Retorne ESTRITAMENTE a linha da mensagem de commit, sem aspas, crases ou explicacoes extras.

Diff:
$DIFF_CONTENT"

    if command -v agy &>/dev/null; then
        agy -p "$PROMPT" 2>/dev/null | tr -d '`' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | head -n 1
    elif [ -n "$GEMINI_API_KEY" ] && command -v python3 &>/dev/null; then
        python3 - << EOF 2>/dev/null
import os
from google import genai
try:
    client = genai.Client(api_key=os.environ.get("GEMINI_API_KEY"))
    res = client.models.generate_content(
        model="gemini-2.5-flash",
        contents="""$PROMPT"""
    )
    print(res.text.strip().replace('`', '').splitlines()[0])
except Exception:
    pass
EOF
    fi
}

echo "Analisando diff e gerando mensagem de commit..."
COMMIT_MSG=$(generate_message)

if [ -z "$COMMIT_MSG" ]; then
    COMMIT_MSG="chore: atualizacoes no projeto"
fi

while true; do
    echo ""
    echo "Mensagem sugerida: $COMMIT_MSG"
    echo ""
    echo "[Enter] Confirmar e commitar"
    echo "[e]     Editar mensagem"
    echo "[r]     Regenerar sugestao"
    echo "[c]     Cancelar"
    read -p "Opcao: " choice

    case "$choice" in
        "")
            git commit -m "$COMMIT_MSG"
            echo "Commit realizado com sucesso."
            break
            ;;
        [eE]*)
            read -p "Digite a nova mensagem de commit: " NEW_MSG
            if [ -n "$NEW_MSG" ]; then
                git commit -m "$NEW_MSG"
                echo "Commit realizado com sucesso."
            else
                echo "Operacao cancelada."
            fi
            break
            ;;
        [rR]*)
            echo "Gerando nova sugestao..."
            COMMIT_MSG=$(generate_message)
            ;;
        [cC]*)
            echo "Operacao cancelada."
            break
            ;;
        *)
            echo "Opcao invalida."
            ;;
    esac
done
