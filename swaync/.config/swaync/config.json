{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 380,
  "control-center-height": 600,
  "notification-window-width": 360,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Central de Controle",
      "clear-all-button": true,
      "button-text": "Limpar Tudo"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "~/.config/hypr/scripts/wifi_toggle.sh"
        },
        {
          "label": "󰂯  BT",
          "type": "toggle",
          "active": true,
          "command": "rfkill toggle bluetooth && notify-send -i bluetooth 'Bluetooth' 'Alternado'"
        },
        {
          "label": "󰔎  Shaders",
          "type": "button",
          "command": "~/.config/hypr/scripts/shader-menu.sh toggle"
        },
        {
          "label": "󰹑  Print",
          "type": "button",
          "command": "grim -g \"$(slurp)\" - | wl-copy && notify-send -i camera-photo 'Screenshot' 'Área copiada'"
        }
      ]
    },
    "dnd": {
      "text": "Não Perturbe"
    },
    "mpris": {
      "image-size": 70,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃠",
      "device": "amdgpu_bl2"
    },
    "notifications": {}
  }
}
