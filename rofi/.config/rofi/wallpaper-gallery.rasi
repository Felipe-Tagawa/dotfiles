/**
 * Rofi Wallpaper Gallery Theme (Dynamic Grid with Visual Thumbnails)
 * Adapts to active desktop Material You palette
 **/

@import "~/.config/rofi/colors/current.rasi"

* {
    font:                        "JetBrainsMono Nerd Font 10";
    selected-text:               #11111bff;
    border-color:                @selected;
}

configuration {
    show-icons:                  true;
    dmenu-display-format:        "{name}";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1120px;
    height:                      700px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               16px;
    border-color:                @border-color;
    background-color:            @background;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     14px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     12px;
    padding:                     12px 16px;
    border-radius:               10px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @selected;
    font:                        "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Filtrar paisagens (Tsushima, Colossus, Elden Ring, Hollow Knight, Destiny...)...";
    placeholder-color:           #787680;
    font:                        "JetBrainsMono Nerd Font 10.5";
}

listview {
    enabled:                     true;
    columns:                     3;
    lines:                       2;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    spacing:                     14px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     8px;
    padding:                     12px;
    border-radius:               14px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
    border:                      2px;
    border-color:                transparent;
}

element normal.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-text;
    border:                      2px;
    border-color:                @active;
}

element-icon {
    background-color:            transparent;
    size:                        155px;
    cursor:                      inherit;
    horizontal-align:            0.5;
    border-radius:               10px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "JetBrainsMono Nerd Font Bold 10";
}
